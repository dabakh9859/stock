# Stock - Configuration native (sans Docker)

# PostgreSQL - base de donnees native (port 5434)
DATABASE_URL=
DB_SSLMODE=

# Serveur
HOST=
PORT=
RELOAD=false

# Init
INIT_DB_ON_STARTUP=
SEED_DEFAULT_DATA=
ENABLE_MIGRATIONS_WORKER=

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Les produits
GOOGLE_SHEETS_AUTO_SYNC=

# URL publique
APP_PUBLIC_URL=
APP_NAME=Stock

# Evolution API (WhatsApp) - tourne en natif sur le host
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=stock

# URL interne pour generation PDF
APP_INTERNAL_URL=
SECRET_KEY=

# Secret partagé avec la boutique en ligne pour confirmer un paiement.
# Doit être identique à celui du .env de /opt/sitegaps.
SHOP_PAYMENT_SECRET=
INTERNAL_API_TOKEN=

# --- Orange SMS Sénégal -------------------------------------------------
# L'opérateur en direct : ~20 F CFA le SMS, vers Orange, Free et Expresso.
# À créer sur https://developer.orange.com/apis/sms-sn/ puis acheter un forfait.
# L'adresse émettrice figure dans les exemples de code de la console Orange.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=
ORANGE_SMS_SENDER_NAME="STOCKLE"

# Mot de passe du compte « admin » créé au premier démarrage.
# Laissé vide, un mot de passe aléatoire est tiré et affiché une seule fois
# dans la console — notez-le.
ADMIN_PASSWORD=
